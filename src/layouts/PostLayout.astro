---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import { TAG_LABELS } from '../config';

interface Props {
  post: CollectionEntry<'posts'>;
  headings: { depth: number; slug: string; text: string }[];
}

const { post, headings } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.published);
const readingHeadings = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
const series = post.data.series ? await getEntry(post.data.series) : undefined;
const seriesPosts = post.data.series
  ? (await getCollection('posts', ({ data }) => !data.draft && data.series?.id === post.data.series?.id))
      .sort((a, b) => (a.data.seriesOrder ?? 0) - (b.data.seriesOrder ?? 0))
  : [];
const seriesIndex = seriesPosts.findIndex((item) => item.id === post.id);
const previousPost = seriesIndex > 0 ? seriesPosts[seriesIndex - 1] : undefined;
const nextPost = seriesIndex >= 0 ? seriesPosts[seriesIndex + 1] : undefined;
---

<BaseLayout title={`${post.data.title} · 相空间札记`} description={post.data.description} article={post}>
  <article class="post-shell">
    <header class="post-header">
      <a class="back-link" href={`${base}/posts/`}>← 返回文章</a>
      <div class="post-meta">
        {series && <><a class="post-series-link" href={`${base}/series/${series.id}/`}>卷 {String(series.data.volume).padStart(2, '0')} · {series.data.title}</a><span aria-hidden="true">·</span></>}
        <time datetime={post.data.published.toISOString()}>{date}</time>
        <span aria-hidden="true">·</span>
        <span>约 {Math.max(4, Math.round((post.body?.length ?? 0) / 900))} 分钟阅读</span>
      </div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
      <div class="post-tags">
        {post.data.tags.map((tag) => <a href={`${base}/tags/${tag}/`}>{TAG_LABELS[tag] ?? tag}</a>)}
      </div>
    </header>

    <div class="post-grid">
      <aside class="toc" aria-label="文章目录">
        <div class="toc-title">本页目录</div>
        {readingHeadings.length > 0 ? (
          <ol>
            {readingHeadings.map((heading) => (
              <li class:list={{ nested: heading.depth === 3 }}><a href={`#${heading.slug}`}>{heading.text}</a></li>
            ))}
          </ol>
        ) : <p>本文暂无分节</p>}
      </aside>
      <div class="prose" data-pagefind-body>
        <slot />
      </div>
      <aside class="margin-note" aria-hidden="true">
        <span>Φ</span>
        <p>结构先于坐标，几何先于计算。</p>
      </aside>
    </div>
    {series && (
      <nav class="series-navigation" aria-label="专栏章节导航">
        <div class="series-progress">
          <div>
            <span>所属专栏</span>
            <a href={`${base}/series/${series.id}/`}>{series.data.title}</a>
          </div>
          <div class="chapter-progress">
            <span>第 {post.data.seriesOrder} 章，共 {seriesPosts.length} 章</span>
            <div><i style={`width: ${((seriesIndex + 1) / seriesPosts.length) * 100}%`}></i></div>
          </div>
        </div>
        <div class="series-neighbours">
          {previousPost ? (
            <a class="previous" href={`${base}/posts/${previousPost.id}/`}><span>← 上一章</span><strong>{previousPost.data.title}</strong></a>
          ) : <div></div>}
          {nextPost ? (
            <a class="next" href={`${base}/posts/${nextPost.id}/`}><span>下一章 →</span><strong>{nextPost.data.title}</strong></a>
          ) : <a class="next" href={`${base}/series/${series.id}/`}><span>返回专栏 →</span><strong>查看完整目录</strong></a>}
        </div>
      </nav>
    )}
  </article>
</BaseLayout>
