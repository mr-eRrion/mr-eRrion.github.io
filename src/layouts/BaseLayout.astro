---
import '../styles/global.css';
import { getCollection, type CollectionEntry } from 'astro:content';
import { i18n, routeLocale, localeBase, assetBase, contentSlug, htmlLang, type Locale } from '../i18n';

interface Props {
  title?: string;
  description?: string;
  article?: CollectionEntry<'posts'>;
  lang?: Locale;
  notFound?: boolean;
}

const lang = Astro.props.lang ?? routeLocale(Astro.params.lang);
const { t, site: SITE } = i18n(lang);
const {
  title = SITE.title,
  description = SITE.description,
  article
} = Astro.props;

const base = localeBase(lang);
const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const socialImage = new URL(`${assetBase}/og-v2.png`, Astro.site);
const relativePath = Astro.url.pathname.slice(base.length) || '/';
const otherLang = lang === 'zh' ? 'en' : 'zh';
let translatedPath = relativePath;
let hasTranslation = !Astro.props.notFound;
if (article) {
  hasTranslation = (await getCollection('posts', ({ data }) => !data.draft && data.lang === otherLang))
    .some((post) => contentSlug(post.id) === contentSlug(article.id));
  if (!hasTranslation) translatedPath = '/posts/';
} else if (Astro.params.slug) {
  hasTranslation = (await getCollection('series', ({ data }) => data.lang === otherLang))
    .some((series) => contentSlug(series.id) === Astro.params.slug);
  if (!hasTranslation) translatedPath = '/series/';
} else if (Astro.params.tag) {
  hasTranslation = (await getCollection('posts', ({ data }) => !data.draft && data.lang === otherLang))
    .some((post) => post.data.tags.includes(Astro.params.tag!));
  if (!hasTranslation) translatedPath = '/tags/';
}
if (Astro.props.notFound) translatedPath = '/';
const alternateURL = new URL(`${localeBase(otherLang)}${translatedPath}`, Astro.site);
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (path: string) => path === '/'
  ? currentPath === (base || '/')
  : currentPath === `${base}${path}` || currentPath.startsWith(`${base}${path}/`);
const navigation = [
  { path: '/', label: t.home, number: '01' },
  { path: '/posts', label: t.allPosts, number: '02' },
  { path: '/series', label: t.series, number: '03' },
  { path: '/tags', label: t.topics, number: '04' },
  { path: '/about', label: t.about, number: '05' }
];
---

<!doctype html>
<html lang={htmlLang(lang)}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />
    {hasTranslation && <>
      <link rel="alternate" hreflang={htmlLang(lang)} href={canonicalURL} />
      <link rel="alternate" hreflang={htmlLang(otherLang)} href={alternateURL} />
      <link rel="alternate" hreflang="x-default" href={lang === 'zh' ? canonicalURL : alternateURL} />
    </>}
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} RSS`} href={`${base}/rss.xml`} />
    <link rel="icon" type="image/png" href={`${assetBase}/favicon.png`} />
    <meta property="og:locale" content={lang === 'zh' ? 'zh_CN' : 'en_US'} />
    {hasTranslation && <meta property="og:locale:alternate" content={lang === 'zh' ? 'en_US' : 'zh_CN'} />}
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    {!article && <meta property="og:image" content={socialImage} />}
    {!article && <meta property="og:image:width" content="1730" />}
    {!article && <meta property="og:image:height" content="909" />}
    {!article && <meta name="twitter:image" content={socialImage} />}
    {article && <meta property="article:published_time" content={article.data.published.toISOString()} />}
    <title>{title}</title>
    <script is:inline>
      try {
        const theme = localStorage.getItem('blog-theme');
        if (theme === 'light' || theme === 'dark') document.documentElement.dataset.theme = theme;
      } catch {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">{t.skip}</a>
    <div class="site-frame">
    <header class="site-sidebar">
      <a class="site-mark" href={`${base}/`} aria-label={t.home}>
        <span class="mark-symbol" aria-hidden="true">Φ</span>
        <span>{SITE.title}</span>
      </a>
      <a class="sidebar-search" href={`${base}/search/`} aria-label={t.searchPosts}><span>{t.searchPosts}</span><span aria-hidden="true">⌕</span></a>
      <nav class="language-switch" aria-label={t.language}>
        <a href={lang === 'zh' ? Astro.url.pathname : alternateURL.pathname} lang="zh-CN" hreflang="zh-CN" aria-current={lang === 'zh' ? 'page' : undefined}>中文</a>
        <a href={lang === 'en' ? Astro.url.pathname : alternateURL.pathname} lang="en" hreflang="en" aria-current={lang === 'en' ? 'page' : undefined}>English</a>
      </nav>
      <details class="sidebar-menu" open>
        <summary>{t.browseSections} <span aria-hidden="true">＋</span></summary>
        <div class="sidebar-group">
          <p class="sidebar-label">{t.explore}</p>
          <nav class="primary-nav" aria-label={t.mainNav}>
            {navigation.map(({ path, label, number }) => (
              <a href={`${base}${path === '/' ? '/' : `${path}/`}`} aria-current={isActive(path) ? 'page' : undefined}>
                <span>{label}</span><small>{number}</small>
              </a>
            ))}
          </nav>
        </div>
        <div class="sidebar-group">
          <p class="sidebar-label">{t.otherSections}</p>
          <nav class="primary-nav" aria-label={t.otherSections}>
            <a href={`${base}/games/`} aria-current={isActive('/games') ? 'page' : undefined}>
              <span>{t.games}</span><small>06</small>
            </a>
            <a href={`${base}/friends/`} aria-current={isActive('/friends') ? 'page' : undefined}>
              <span>{t.friends}</span><small>07</small>
            </a>
          </nav>
        </div>
        <div class="sidebar-note"><span>{t.posts} / {SITE.author}</span><p>{SITE.motto}</p><a href={`${base}/rss.xml`}>{t.rss}</a></div>
      </details>
      <div class="theme-switch" role="group" aria-label={t.appearance}>
        <button type="button" data-theme-choice="light" aria-label={t.lightTheme} aria-pressed="false">☼ <span>{t.light}</span></button>
        <button type="button" data-theme-choice="dark" aria-label={t.darkTheme} aria-pressed="false">☾ <span>{t.dark}</span></button>
        <button type="button" data-theme-choice="system" aria-label={t.systemTheme} aria-pressed="true">◐ <span>{t.system}</span></button>
      </div>
    </header>
    <div class="site-content">
    <div class="edition-stripe" aria-hidden="true"></div>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
        <span>© {new Date().getFullYear()} {SITE.title}</span>
      <span class="footer-motto">{SITE.motto}</span>
    </footer>
    </div>
    </div>
    <script>
      const menu = document.querySelector<HTMLDetailsElement>('.sidebar-menu');
      const narrowScreen = window.matchMedia('(max-width: 760px)');
      const syncMenu = () => { if (menu) menu.open = !narrowScreen.matches; };
      syncMenu();
      narrowScreen.addEventListener('change', syncMenu);
      const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]');
      const syncThemeButtons = () => themeButtons.forEach((button) => {
        button.setAttribute('aria-pressed', String(button.dataset.themeChoice === (document.documentElement.dataset.theme || 'system')));
      });
      syncThemeButtons();
      themeButtons.forEach((button) => button.addEventListener('click', () => {
        const theme = button.dataset.themeChoice!;
        if (theme === 'system') delete document.documentElement.dataset.theme;
        else document.documentElement.dataset.theme = theme;
        try { localStorage.setItem('blog-theme', theme); } catch {}
        syncThemeButtons();
      }));
    </script>
  </body>
</html>
