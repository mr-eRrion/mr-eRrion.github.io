---
import BaseLayout from '../layouts/BaseLayout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<BaseLayout title="关于 · 相空间札记" description="关于相空间札记。">
  <section class="about-shell" data-pagefind-body>
    <header><span class="eyebrow">ABOUT</span><h1>我是一个正在学习的人<br />请和我交朋友</h1></header>
    <div class="about-grid">
      <div class="about-aside">
        <img src={`${base}/chara.png`} alt="eRrion 的头像" width="230" height="230" />
        <p>eRrion<br />PHASE SPACE NOTES</p>
      </div>
      <div class="about-copy">
        <p class="lead">你好，我是 eRrion。这里是我整理数学与物理学习过程的笔记，偶尔随机掉落其他随笔。</p>
        <p>我主要关注凝聚态理论，也会记录研究项目以及阅读过程中逐渐形成的问题。这里的数学与物理各自拥有独立的位置：有时研究数学结构，有时讨论具体的物理机制，也会在二者自然相遇时追踪它们之间的联系。</p>
        <p>有哪些优秀的百合同人作品？</p>
      </div>
    </div>
  </section>
</BaseLayout>
