---
import NotFound from '../components/NotFound.astro';
import { assetBase } from '../i18n';
---
<NotFound lang="zh" />
<script is:inline define:vars={{ assetBase }}>
  // Static hosts serve this same fallback for both languages.
  if (location.pathname.startsWith(`${assetBase}/en/`)) location.replace(`${assetBase}/en/404/`);
</script>
