---
import { i18n, routeLocale, localeBase, languagePaths, contentSlug } from '../../i18n';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = languagePaths;

const lang = routeLocale(Astro.params.lang);
const { t, site } = i18n(lang);
const base = localeBase(lang);
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang)).sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const years = Map.groupBy(posts, (post) => post.data.published.getFullYear());
---

<BaseLayout title={`${t.archive} · ${site.title}`}>
  <section class="listing-shell compact-listing">
    <header class="listing-header"><span class="eyebrow">{t.archive.toUpperCase()}</span><h1>{t.archive}</h1><p>{t.archiveIntro(posts.length)}</p></header>
    <div class="archive-list">
      {[...years.entries()].map(([year, yearPosts]) => (
        <section>
          <h2>{year}</h2>
          <ol>
            {yearPosts.map((post) => (
              <li><time>{String(post.data.published.getMonth() + 1).padStart(2, '0')}.{String(post.data.published.getDate()).padStart(2, '0')}</time><a href={`${base}/posts/${contentSlug(post.id)}/`}>{post.data.title}</a></li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  </section>
</BaseLayout>
