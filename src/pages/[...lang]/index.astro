---
import { i18n, routeLocale, localeBase, languagePaths, contentSlug } from '../../i18n';
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = languagePaths;

const lang = routeLocale(Astro.params.lang);
const { t, tags: TAG_LABELS } = i18n(lang);
const base = localeBase(lang);
const posts = (await getCollection('posts', ({ data }) => !data.draft && data.lang === lang)).sort(
  (a, b) => b.data.published.valueOf() - a.data.published.valueOf()
);
const pinnedPosts = posts.filter(({ data }) => data.featured).slice(0, 3);
const pinnedIds = new Set(pinnedPosts.map((post) => post.id));
const timelinePosts = posts.filter((post) => !pinnedIds.has(post.id));
const formatDate = (date: Date) => date.toISOString().slice(0, 10).replaceAll('-', '.');
---

<BaseLayout>
  <header class="home-intro page-shell">
    <div class="home-breadcrumb"><span aria-hidden="true">/</span><span>{t.home}</span></div>
    <p>{t.greeting}</p>
  </header>

  <div class="home-feed page-shell" data-pagefind-body>
    {pinnedPosts.length > 0 && (
      <section class="pinned-section" aria-labelledby="pinned-heading">
        <div class="home-section-heading">
          <h2 id="pinned-heading">{t.pinned}</h2>
          <span>{t.pinned.toUpperCase()} / {String(pinnedPosts.length).padStart(2, '0')}</span>
        </div>
        <div class="pinned-posts">
          {pinnedPosts.map((post) => (
            <a class="pinned-post" href={`${base}/posts/${contentSlug(post.id)}/`}>
              <div class="pinned-post-meta">
                <span>{t.pinnedPost}</span>
                <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
              </div>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
              <span class="pinned-post-arrow" aria-hidden="true">↗</span>
            </a>
          ))}
        </div>
      </section>
    )}

    <section class="timeline-section" aria-labelledby="timeline-heading">
      <div class="home-section-heading">
        <h2 id="timeline-heading">{t.latest}</h2>
        <a href={`${base}/archive/`}>{t.list} <span aria-hidden="true">→</span></a>
      </div>
      <div class="home-timeline">
        {timelinePosts.map((post) => (
          <article class="timeline-post">
            <time datetime={post.data.published.toISOString()}>{formatDate(post.data.published)}</time>
            <div class="timeline-post-copy">
              <span class="timeline-post-tags">
                {post.data.tags.map((tag) => TAG_LABELS[tag] ?? tag).join(' · ')}
              </span>
              <h3><a href={`${base}/posts/${contentSlug(post.id)}/`}>{post.data.title}</a></h3>
              <p>{post.data.description}</p>
            </div>
            <a class="timeline-post-arrow" href={`${base}/posts/${contentSlug(post.id)}/`} aria-label={`${t.read}${post.data.title}`}>→</a>
          </article>
        ))}
      </div>
    </section>
  </div>
</BaseLayout>
