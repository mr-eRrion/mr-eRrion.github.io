---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { i18n, routeLocale, languagePaths, localeBase } from '../../../i18n';
export const getStaticPaths = languagePaths;
const lang = routeLocale(Astro.params.lang);
const { t, site } = i18n(lang);
const zh = lang === 'zh';
const rules = zh
  ? '点击抽号，卡片上的对应数字会自动点亮。中央格免费点亮；横、竖或对角线连满 5 格，即为 Bingo！'
  : 'Draw a number to mark matching cells automatically. The center is free. Complete a row, column, or diagonal of five to get Bingo!';
---
<BaseLayout title={`Bingo · ${site.title}`} description={rules}>
  <section class="listing-shell" data-pagefind-body>
    <header class="listing-header">
      <a class="back-link" href={`${localeBase(lang)}/games/`}>← {t.games}</a>
      <h1>{zh ? '来一局 Bingo' : 'A round of Bingo'}</h1>
      <p>{rules}</p>
    </header>
    <noscript><p>{zh ? '请启用 JavaScript 后开始游戏。' : 'Enable JavaScript to play.'}</p></noscript>
    <div id="bingo" data-lang={lang} data-pagefind-ignore hidden>
      <div class="game-layout">
        <div>
          <div class="letters" aria-hidden="true">{[...'BINGO'].map((letter) => <span>{letter}</span>)}</div>
          <div class="board" role="group" aria-label={zh ? 'Bingo 卡片' : 'Bingo card'}>
            {Array.from({ length: 25 }, () => <div class="cell"><span></span><small></small></div>)}
          </div>
        </div>
        <aside class="draw-panel">
          <span class="eyebrow">{zh ? '本次抽号' : 'LATEST DRAW'}</span>
          <div id="latest" aria-hidden="true">—</div>
          <p id="progress"></p>
          <button id="draw" type="button">{zh ? '抽一个号码' : 'Draw a number'}</button>
          <button id="restart" class="secondary" type="button">{zh ? '重新开局' : 'New game'}</button>
          <p class="hint">{zh ? '1–75 不重复抽取。可继续挑战多条连线；重新开局会更换卡片，刷新页面也会开始新局。' : 'Draw from 1–75 without repeats. Keep playing for more lines. A new game or page reload resets the card.'}</p>
        </aside>
      </div>
      <p id="status" role="status" aria-live="polite" aria-atomic="true"></p>
      <details class="history"><summary>{zh ? '查看已抽号码' : 'Draw history'}</summary><p id="history"></p></details>
    </div>
  </section>
</BaseLayout>

<script>
  import { createCard, shuffle, winningLines } from '../../../lib/bingo';
  const game = document.querySelector<HTMLElement>('#bingo')!;
  const zh = game.dataset.lang === 'zh';
  const cells = [...game.querySelectorAll<HTMLElement>('.cell')];
  const drawButton = game.querySelector<HTMLButtonElement>('#draw')!;
  const status = game.querySelector<HTMLElement>('#status')!;
  let card: (number | null)[];
  let deck: number[];
  let drawn: Set<number>;
  const label = (n: number) => `${'BINGO'[Math.floor((n - 1) / 15)]} ${n}`;

  function render() {
    const lines = winningLines(card, drawn);
    const winning = new Set(lines.flat());
    cells.forEach((cell, i) => {
      const free = card[i] === null;
      const marked = free || drawn.has(card[i]!);
      cell.querySelector('span')!.textContent = free ? '★' : String(card[i]);
      cell.querySelector('small')!.textContent = free ? (zh ? '自由格' : 'FREE') : marked ? '✓' : '';
      cell.classList.toggle('marked', marked);
      cell.classList.toggle('winning', winning.has(i));
      cell.setAttribute('aria-label', free ? (zh ? '自由格，已点亮' : 'Free, marked') : `${label(card[i]!)}${marked ? (zh ? '，已点亮' : ', marked') : ''}`);
    });
    const latest = [...drawn].at(-1);
    game.querySelector('#latest')!.textContent = latest ? label(latest) : '—';
    game.querySelector('#progress')!.textContent = zh ? `已抽 ${drawn.size} / 75 · 连线 ${lines.length} / 12` : `Drawn ${drawn.size} / 75 · Lines ${lines.length} / 12`;
    game.querySelector('#history')!.textContent = [...drawn].map(label).join(' · ') || (zh ? '还没有抽号。' : 'No numbers drawn yet.');
    const result = lines.length ? (zh ? `Bingo！已完成 ${lines.length} 条连线。` : `Bingo! ${lines.length} completed lines.`) : (zh ? '再试试，下一条连线就在前面。' : 'Keep going for your first line.');
    status.textContent = !latest ? (zh ? '卡片准备好了，抽取第一个号码吧。' : 'Your card is ready. Draw your first number.') : `${zh ? '抽到' : 'Drawn'} ${label(latest)}. ${result}${deck.length ? '' : (zh ? '号码已全部抽完，可以重新开局。' : 'All numbers drawn. Start a new game to play again.')}`;
    drawButton.disabled = deck.length === 0;
  }

  function start() {
    card = createCard();
    deck = shuffle(Array.from({ length: 75 }, (_, i) => i + 1));
    drawn = new Set();
    render();
  }
  drawButton.addEventListener('click', () => {
    const number = deck.pop();
    if (number === undefined) return;
    drawn.add(number);
    render();
  });
  game.querySelector('#restart')!.addEventListener('click', start);
  start();
  game.hidden = false;
</script>

<style>
  .game-layout { display: grid; grid-template-columns: minmax(0, 440px) minmax(180px, 1fr); gap: 32px; margin-top: 32px; align-items: start; }
  .letters, .board { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 6px; }
  .letters { margin-bottom: 12px; text-align: center; color: var(--blue); font: 24px var(--serif); }
  .cell { aspect-ratio: 1; display: flex; flex-direction: column; justify-content: center; align-items: center; border: 1px solid var(--rule); background: var(--paper); font: clamp(19px, 3vw, 32px) var(--mono); }
  .cell small { height: 14px; font: 10px/14px var(--sans); }
  .cell.marked { background: var(--paper-deep); color: var(--blue); border-color: var(--blue); }
  .cell.winning { color: var(--paper); background: var(--blue); border-color: var(--blue); }
  .draw-panel { padding: 24px; border: 1px solid var(--rule); }
  #latest { margin: 18px 0; color: var(--blue); font: clamp(32px, 4vw, 48px) var(--serif); }
  #progress, .hint, .history { color: var(--ink-soft); font-size: 12px; line-height: 1.8; }
  button { width: 100%; min-height: 44px; padding: 10px; border: 1px solid var(--blue); background: var(--blue); color: var(--paper); font: inherit; font-size: 14px; cursor: pointer; }
  button.secondary { margin-top: 10px; background: transparent; color: var(--ink); border-color: var(--rule); }
  button:hover { filter: brightness(.92); }
  button:focus-visible { outline: 2px solid var(--blue); outline-offset: 4px; }
  button:disabled { opacity: .45; cursor: default; }
  .hint { margin-bottom: 0; }
  #status { padding: 18px 0; border-block: 1px solid var(--rule); font-size: 14px; line-height: 1.8; }
  .history summary { cursor: pointer; }
  @media (max-width: 1000px) { .game-layout { grid-template-columns: minmax(0, 1fr); } .draw-panel { padding: 20px; } }
</style>
