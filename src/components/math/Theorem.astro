---
import { i18n, routeLocale } from '../../i18n';
const { t } = i18n(routeLocale(Astro.params.lang));
interface Props {
  name?: string;
  number?: string;
}

const { name, number } = Astro.props;
---

<aside class="math-environment theorem">
  <div class="environment-title">
    <strong>{t.theorem}{number ? ` ${number}` : ''}</strong>{name && <span>{Astro.params.lang === 'en' ? ` (${name})` : `（${name}）`}</span>}
  </div>
  <slot />
</aside>
